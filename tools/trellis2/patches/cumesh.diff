+// set_flag_kernel with a bounds check: fill_holes computes the offsets of the kept loops from per-loop counts and the flag array from per-boundary masks;
+// on a non-manifold mesh (a loop of zero boundaries shares its offset with the next) the two disagree and an offset can point past the array.
+// NVIDIA allocations happened to absorb the overrun; on AMD it is an illegal address. Out-of-range writes are dropped.
+__global__ void set_flag_bounded_kernel(const int* indices, const size_t N, int* output, const size_t size) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= N) return;
+    const int i = indices[tid];
+    if (i >= 0 && (size_t)i < size) output[i] = 1;
+}
